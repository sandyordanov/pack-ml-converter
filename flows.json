l background */\n    }\n\n\n\n    .close {\n      color: black;\n      /* Changed from white to black */\n      float: right;\n      font-size: 28px;\n      font-weight: bold;\n    }\n\n    .close:hover,\n    .close:focus {\n      color: darkgray;\n      /* Changed hover color to dark gray */\n      text-decoration: none;\n      cursor: pointer;\n    }\n  </style>\n\n  <script>\n    (function(scope) {\n      scope.showModal = false;\n\n      // Handle the click event to open the modal\n      scope.openModal = function(stage) {\n          scope.selectedStage = stage;\n\n          // Fetch timestamp from msg.payload for the selected stage\n          const stageData = scope.msg.payload[\"N\" + stage];\n          const endCode = stageData.endCode;\n          if (stageData && stageData.timestamp) {\n              const timestamp = new Date(stageData.timestamp);\n              const minutes = Math.floor((Date.now() - stageData.timestamp) / 60000); // Elapsed time in minutes\n              const seconds = Math.floor(((Date.now() - stageData.timestamp) % 60000) / 1000); // Remaining seconds\n\n              // Update modal content with formatted timestamp\n              scope.stageDetails = \n                  \"Start Time: \" + timestamp.toLocaleTimeString() + \"<br>\" +\n                  \"Elapsed Time: \" + minutes + \" minutes and \" + seconds + \" seconds\" + \"<br>\" +\n                  \"Latest EndCode: \" + endCode;\n          } else {\n              scope.stageDetails = \"No data available for this stage.\" + \"<br>\" +\n              \"Latest EndCode: \" + endCode;\n\n          }\n\n          scope.showModal = true;\n          scope.$apply(); // Apply scope changes immediately\n      };\n\n      // Function to close the modal\n      scope.closeModal = function() {\n        scope.showModal = false;\n        scope.$apply();\n      };\n    })(scope);\n  </script>\n</div>","storeOutMessages":true,"fwdInMessages":true,"resendOnRefresh":true,"templateScope":"local","className":"","x":1030,"y":320,"wires":[[]]},{"id":"d05ed845719ff7bb","type":"function","z":"6794c58242156d5e","name":"Convert Packtag for UI","func":"// Initialize stages states if not already set\nif (!context.get('stages')) {\n    context.set('stages', {\n        \"N105\": { text: \"IDLE\", color: \"white\", fontColor: \"black\", timestamp: null, endCode: null },\n        \"N115\": { text: \"IDLE\", color: \"white\", fontColor: \"black\", timestamp: null, endCode: null },\n        \"N120\": { text: \"IDLE\", color: \"white\", fontColor: \"black\", timestamp: null, endCode: null },\n        \"N125\": { text: \"IDLE\", color: \"white\", fontColor: \"black\", timestamp: null, endCode: null },\n        \"N135\": { text: \"IDLE\", color: \"white\", fontColor: \"black\", timestamp: null, endCode: null },\n        \"N140\": { text: \"IDLE\", color: \"white\", fontColor: \"black\", timestamp: null, endCode: null },\n        \"N145\": { text: \"IDLE\", color: \"white\", fontColor: \"black\", timestamp: null, endCode: null },\n        \"N160\": { text: \"IDLE\", color: \"white\", fontColor: \"black\", timestamp: null, endCode: null }\n    });\n}\n\n// Retrieve the initialized stages array from context\nlet stages = context.get('stages');\n\n// Ensure msg.payload is parsed to JSON if it's a string\nif (typeof msg.payload === 'string') {\n    try {\n        msg.payload = JSON.parse(msg.payload);\n    } catch (err) {\n        node.error(\"Failed to parse msg.payload as JSON: \" + err.message);\n        return null; // Stop processing if the payload isn't valid JSON\n    }\n}\n\nnode.warn(\"parsed msg.payload: \" + JSON.stringify(msg.payload));\n\n// Extract necessary fields with optional chaining\nlet name = msg.payload?.name;\nlet currentState = msg.payload?.status?.StateCurrent?.toUpperCase(); // Convert to uppercase\nlet endCode = msg.payload?.admin?.[\"StopReason.ID\"]; \n\n// Check if currentState or name is missing\nif (!currentState) {\n    node.warn(\"StateCurrent is missing or undefined in the payload.\");\n    return null; // Stop processing if required data is missing\n}\n\nif (!name) {\n    node.warn(\"Name is missing or undefined in the payload.\");\n    return null;\n}\n\n// Check if the stageName is valid (i.e., it exists in the boxes object)\nif (stages.hasOwnProperty(name)) {\n    // Update the specific box based on status\n    if (currentState === \"IDLE\") {\n        stages[name] = {\n            text: \"IDLE\",\n            color: \"white\",\n            fontColor: \"black\",\n            timestamp: null,\n            endCode: endCode\n        };\n    } else if (currentState === \"EXECUTE\") {\n        stages[name] = {\n            text: \"EXECUTING\",\n            color: \"green\",\n            fontColor: \"white\",\n            timestamp: new Date().getTime(), // Record the current timestamp in milliseconds\n            endCode: endCode\n        };\n    } else if (currentState === \"ABORTED\") {\n        stages[name] = {\n            text: \"ABORTED\",\n            color: \"red\",\n            fontColor: \"white\",\n            timestamp: null,\n            endCode: endCode\n        };\n    }\n    else if (currentState === \"COMPLETE\") {\n        stages[name] = {\n            text: \"COMPLETED\",\n            color: \"yellow\",\n            fontColor: \"black\",\n            timestamp: null,\n            endCode: endCode\n        };\n    }\n}\n\n// Do not include `productionStatus` in the stages\nlet relevantStages = Object.values(stages);\n\n// Check the overall production line status\nlet productionStatus = { text: \"IDLE\", color: \"white\", fontColor: \"black\" }; // Default to IDLE\n\n// Determine the production status based on the stage statuses\nif (relevantStages.some(stage => stage.text === \"ABORTED\")) {\n    productionStatus = { text: \"ABORTED\", color: \"red\", fontColor: \"white\" };\n} else if (relevantStages.some(stage => stage.text === \"EXECUTING\")) {\n    productionStatus = { text: \"EXECUTING\", color: \"green\", fontColor: \"white\" };\n}\n\n// Assign the updated stages and production status to the output payload\nmsg.payload = { ...stages, productionStatus };\n\n// Send the updated message\nreturn msg;\n","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":760,"y":320,"wires":[["d506ae5f572831ce","3f2b8b743f78bc34","6487855d2504808d"]]},{"id":"3c1d09d581f84150","type":"inject","z":"6794c58242156d5e","g":"533c33adafce7c09","name":"N105 IDLE STATE","props":[{"p":"payload"},{"p":"topic","vt":"str"}],"repeat":"","crontab":"","once":false,"onceDelay":0.1,"topic":"","payload":"{\"name\":\"N105\",\"command\":{\"UnitMode\":\"None\",\"UnitModeChangeRequest\":\"None\",\"MachSpeed\":\"None\",\"CntrlCmd\":\"None\",\"CmdChangeRequest\":\"None\"},\"status\":{\"UnitModeCurrent\":\"None\",\"StateCurrent\":\"IDLE\",\"MachSpeed\":\"None\",\"CurMachSpeed\":\"None\",\"EquipmentInterlock.Blocked\":\"None\",\"EquipmentInterlock.Starved\":\"None\"},\"admin\":{\"StopReason.ID\":\"1\",\"ProdProcessedCount[#].Count\":\"None\",\"ProdDefectiveCount[#].Count\":\"None\"}}","payloadType":"json","x":430,"y":340,"wires":[["d05ed845719ff7bb"]]},{"id":"220c779adcb18329","type":"inject","z":"6794c58242156d5e","g":"533c33adafce7c09","name":"N115 IDLE STATE","props":[{"p":"payload"},{"p":"topic","vt":"str"}],"repeat":"","crontab":"","once":false,"onceDelay":0.1,"topic":"","payload":"{\"name\":\"N115\",\"command\":{\"UnitMode\":\"None\",\"UnitModeChangeRequest\":\"None\",\"MachSpeed\":\"None\",\"CntrlCmd\":\"None\",\"CmdChangeRequest\":\"None\"},\"status\":{\"UnitModeCurrent\":\"None\",\"StateCurrent\":\"IDLE\",\"MachSpeed\":\"None\",\"CurMachSpeed\":\"None\",\"EquipmentInterlock.Blocked\":\"None\",\"EquipmentInterlock.Starved\":\"None\"},\"admin\":{\"StopReason.ID\":\"1\",\"ProdProcessedCount[#].Count\":\"None\",\"ProdDefectiveCount[#].Count\":\"None\"}}","payloadType":"json","x":430,"y":420,"wires":[["d05ed845719ff7bb"]]},{"id":"bda60f43af469f4d","type":"inject",